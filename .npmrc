# Project-scoped npm registry.
#
# registry.npmjs.org was intermittently unreachable from this network (repeated
# ECONNRESET on package fetches, which made `npm ci` / `npm install` fail with
# npm's "Exit handler never called!"). The China mirror resolves reliably here.
#
# This file is committed on purpose: it keeps every developer and CI run on the
# same registry instead of relying on a machine-wide `npm config set registry`.
registry=https://registry.npmmirror.com