node_modules/
dist/
dist-test/
backend/dist/
backend/dist-test/
coverage/
.env
.env.local
*.log
# Uploaded images (cover photos, avatars, portfolio shots). Runtime output of
# `UploadService`, written under `UPLOAD_DIR`; in production it is a mounted
# volume (see docker-compose.*.yml), never part of the repo.
backend/uploads/
uploads/

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
# `boya_shared` is a library: its lockfile is not committed, so downstream apps
# resolve their own compatible versions. The two apps are applications, so their
# lockfiles ARE tracked — without them every CI `flutter pub get` resolves fresh
# versions and the build stops being reproducible.
/mobile/shared/pubspec.lock

.idea/
.vscode/
*.iml
.integration-ready
# Local manual-test helpers that touch the dev database. Not committed: they are
# scaffolding for a developer running an E2E check by hand, not part of the app
# or CI. `test-referral.sh` predates this rule and stays tracked.
backend/scripts/test-invite.sh
backend/scripts/test-invite-api.sh
.e2e/

.DS_Store
Thumbs.db
# Local tool artifact (e.g. `.freebuff/project-id`), not part of the repo.
.freebuff/
/node_modules
/vendor
/storage
/.git

# Flutter build artifacts — regenerated by `flutter build web` and not part of
# the repo (was tracked as a temp deploy artifact in 07e80f4; ~227k lines per
# pull). The customer-web Docker image expects build/web at build time, so run
# `flutter build web --base-href /app/` on the host before `docker compose
# -f docker-compose.production.yml build`.
mobile/customer_app/build/
mobile/salon_app/build/

# Local deploy/inspect helpers copied to the production host, not part of the repo.
.tmp-*.sh
