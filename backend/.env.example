# Copy to .env. Never commit real secrets.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL 16 (docker-compose.yml — منبع واحد پورت)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=beauty
DATABASE_PASSWORD=change-me
DATABASE_NAME=beauty_platform
DATABASE_SSL=false

# Redis (docker-compose.yml — منبع واحد پورت)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT — generate a long random string. Do not reuse across environments.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d

# Stripe Connect — use test keys locally. Live keys stay in the secret store.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CONNECT_CLIENT_ID=ca_change_me

# Phase 1 is a free showcase: online payments are OFF. The payment module ships
# in the tree but every route answers 503 until this is set to true (Phase 2).
PAYMENTS_ENABLED=false

# Kavenegar SMS (https://kavenegar.com)
KAVENEGAR_API_KEY=change-me
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=boya-otp
KAVENEGAR_BOOKING_TEMPLATE=
OTP_PEPPER=change-me-otp-pepper

# FCM push (https://console.firebase.google.com) — Firebase console →
# Project settings → Service accounts. Leave unset to disable push: the
# reminder sweep keeps running on the in-app notification and SMS channels.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n escapes; the value is unescaped at read time.
FIREBASE_PRIVATE_KEY=

# Neshan Maps (server-side geocoding, if used)
NESHAN_API_KEY=change-me

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
