# Copy to .env. Never commit real secrets.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL 16 (docker-compose.yml — منبع واحد پورت)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=beauty
DATABASE_PASSWORD=change-me
DATABASE_NAME=beauty_platform
DATABASE_SSL=false

# Redis (docker-compose.yml — منبع واحد پورت)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT — generate a long random string. Do not reuse across environments.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d

# Stripe Connect — use test keys locally. Live keys stay in the secret store.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CONNECT_CLIENT_ID=ca_change_me

# Phase 1 is a free showcase: online payments are OFF. The payment module ships
# in the tree but every route answers 503 until this is set to true (Phase 2).
PAYMENTS_ENABLED=false

# Melipayamak SMS (https://www.melipayamak.com)
# bodyId values are the numeric shared-service pattern codes approved in the
# Melipayamak panel (کد عددی پترن). Leave a bodyId empty to skip that send.
MELIPAYAMAK_USERNAME=change-me
MELIPAYAMAK_PASSWORD=change-me
# Sender number used only by the direct-SMS fallback (no pattern). Leave empty
# to disable the fallback; the pattern API sends from the shared service number.
MELIPAYAMAK_SENDER=
MELIPAYAMAK_URL=https://rest.payamak-panel.com/api/SendSMS/
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_BOOKING_BODY_ID=
# Invite deep link (ADR-010). The SMS carries `${INVITE_BASE_URL}?token=<64hex>`,
# so with this unset the recipient gets only the bare token — nothing can open it.
# Point it at the app the invitee uses: staging first, then the real domain.
INVITE_BASE_URL=https://staging.boya.ir
# Invite patterns (bodyId). The generic one is required; the per-role overrides are
# optional and fall back to it, so a single pattern is enough until owner and
# specialist invites need different wording.
MELIPAYAMAK_INVITE_BODY_ID=
MELIPAYAMAK_INVITE_OWNER_BODY_ID=
MELIPAYAMAK_INVITE_SPECIALIST_BODY_ID=
# Invites (ADR-010) — how long a salon staff invite stays redeemable, in days.
INVITE_EXPIRY_DAYS=7
OTP_PEPPER=change-me-otp-pepper
# Set to true in local dev to log OTP codes instead of sending SMS.
OTP_DEV_MODE=false

# FCM push (https://console.firebase.google.com) — Firebase console →
# Project settings → Service accounts. Leave unset to disable push: the
# reminder sweep keeps running on the in-app notification and SMS channels.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n escapes; the value is unescaped at read time.
FIREBASE_PRIVATE_KEY=

# Neshan Maps (server-side geocoding, if used)
NESHAN_API_KEY=change-me

# Uploaded images (cover, avatar, portfolio): the directory UploadService
# writes into and the API serves statically at /uploads/. The default is
# <backend cwd>/uploads; set it explicitly when a volume owns the directory.
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
