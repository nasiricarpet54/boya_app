{
  "name": "@beauty-platform/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant beauty services API (NestJS 11, TypeORM, PostgreSQL, Redis)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "jest --passWithNoTests",
    "test:e2e": "tsc -p tsconfig.test.json && node --test dist-test/test/auth.e2e-spec.js dist-test/test/otp.service.spec.js dist-test/test/availability.service.spec.js dist-test/test/cancellation-policy.service.spec.js dist-test/test/in-app-notification.service.spec.js dist-test/test/referral-code.service.spec.js dist-test/test/loyalty-point.service.spec.js",
    "test:integration": "jest --config ./test/jest-integration.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.migration.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.migration.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.migration.ts migration:show",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.migration.ts migration:generate"
  },
  "dependencies": {
    "@jeonghochoi/rbac": "0.1.7",
    "@keyv/redis": "5.1.6",
    "@mirad-work/sms-core": "0.5.1",
    "@mirad-work/sms-nestjs": "0.5.0",
    "@nestjs/bull": "12.0.0",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "bull": "4.16.5",
    "cache-manager": "6.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "date-fns-jalali": "4.4.0-0",
    "firebase-admin": "14.5.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "keyv": "5.6.0",
    "nestjs-cls": "6.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.6.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.10",
    "@types/passport-jwt": "4.0.1",
    "jest": "30.2.0",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
