# BOYA — production environment template.
# Copy to .env (repo root, gitignored) and replace every CHANGE_ME value.
# Never commit real secrets.

BACKEND_PORT=3021
DOMAIN=boya.bcshopir.ir
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=beauty
DATABASE_PASSWORD=CHANGE_ME_STRONG
DATABASE_NAME=beauty_platform
DATABASE_MIGRATION_USER=beauty
DATABASE_MIGRATION_PASSWORD=CHANGE_ME_STRONG

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS
OTP_PEPPER=CHANGE_ME_32_CHARS
OTP_DEV_MODE=false

SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=CHANGE_ME
MELIPAYAMAK_PASSWORD=CHANGE_ME
MELIPAYAMAK_FROM=CHANGE_ME

INVITE_BASE_URL=https://boya.bcshopir.ir
INVITE_EXPIRY_DAYS=7

CORS_ORIGINS=https://boya.bcshopir.ir

PAYMENTS_ENABLED=false