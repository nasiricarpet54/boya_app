boya.bcshopir.ir {
    encode zstd gzip

    # API + Swagger + Uploads
    handle /api/* {
        reverse_proxy backend:3000
    }
    handle /docs* {
        reverse_proxy backend:3000
    }
    handle /uploads/* {
        reverse_proxy backend:3000
    }

    # Admin Panel
    handle /admin {
        redir * /admin/fa 308
    }
    handle /admin/ {
        redir * /admin/fa 308
    }
    handle /admin* {
        reverse_proxy admin:3001
    }

    # Customer Web App
    handle_path /app/* {
        header Permissions-Policy "geolocation=(self \"https://boya.bcshopir.ir\")"
        reverse_proxy customer-web:80
    }
    handle /app {
        header Permissions-Policy "geolocation=(self \"https://boya.bcshopir.ir\")"
        redir * /app/ 308
    }

    # Salon Web App
    handle_path /salon/* {
        reverse_proxy salon-web:80
    }
    handle /salon {
        redir * /salon/ 308
    }

    # Fallback
    handle {
        redir * /app/ 308
    }
}
