{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(flutter analyze)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "ask": [
      "Write",
      "Edit",
      "Bash(git push *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(npm install *)",
      "Bash(npm run migration:*)",
      "Bash(npx playwright *)",
      "Bash(flutter build *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(config/secrets.json)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(config/secrets.json)",
      "WebSearch"
    ]
  },
  "model": "sonnet"
}